# MySQL / Prisma
DATABASE_URL="mysql://ispbilling:ispbilling@localhost:3306/isp_billing"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=ispbilling
DATABASE_PASSWORD=ispbilling
DATABASE_NAME=isp_billing

PORT=4311
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
TZ=Asia/Manila

# Hourly automation runner
AUTOMATION_INTERVAL_MS=3600000

# v0.7 encrypts stored PPPoE passwords before they are written to MySQL.
# Set a strong private value and KEEP IT. Changing it later makes existing stored PPPoE passwords unreadable.
NETWORK_SECRET_KEY=replace-with-a-long-random-secret

# MULTI-MIKROTIK CREDENTIALS
# Each Network > MikroTik device has a Credential Key.
# Example device credentialKey = MT1 -> MIKROTIK_MT1_USER / MIKROTIK_MT1_PASSWORD.
MIKROTIK_MT1_USER=ispbilling-api
MIKROTIK_MT1_PASSWORD=change-me
MIKROTIK_MT2_USER=ispbilling-api
MIKROTIK_MT2_PASSWORD=change-me

# Add more routers using the same pattern, e.g. credentialKey GOOD ->
# MIKROTIK_GOOD_USER=ispbilling-api
# MIKROTIK_GOOD_PASSWORD=change-me

# Keep false in production. HTTP exposes Basic Auth credentials on the LAN.
MIKROTIK_ALLOW_INSECURE_HTTP=false

# Automatic backups. If omitted, defaults to <project>\backups.
BACKUP_DIR=C:\ProgramData\ISP Billing\backups

# MikroTik 3 - Trusted / No Auto Cut
MIKROTIK_MT3_USER=ispbilling-api
MIKROTIK_MT3_PASSWORD=change-me
